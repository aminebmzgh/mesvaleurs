# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais commiter de fichier .env contenant des secrets.

# Nom affiché de l'application
NEXT_PUBLIC_APP_NAME=MesValeurs

# URL publique de l'application (liens dans les e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase : en local, valeurs affichées par `pnpm db:start` (API URL, clé anon / publishable).
# Sur Vercel : Project Settings > API du projet Supabase correspondant.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role / secret : SERVEUR UNIQUEMENT (invitations, tâches planifiées, webhooks).
# Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails transactionnels (Resend) — utilisé à partir de la Phase 2
RESEND_API_KEY=
# Expéditeur des e-mails, sur un domaine vérifié chez Resend (ex. « MesValeurs <alertes@mesvaleurs.ma> »).
# Sans RESEND_API_KEY ni EMAIL_FROM, le récapitulatif quotidien des alertes n'est pas envoyé.
EMAIL_FROM=

# Secret protégeant les routes des tâches planifiées Vercel Cron (au moins 16 caractères aléatoires).
# Vercel l'envoie dans l'en-tête « Authorization: Bearer … » des appels planifiés (vercel.json).
CRON_SECRET=

# Lecture des factures par IA (OpenRouter) : SERVEUR UNIQUEMENT. Sans clé, la fonction n'est pas proposée.
# Chaque entreprise l'active ensuite elle-même (paramètres de l'entreprise, accord loi 09-08).
OPENROUTER_API_KEY=
# Modèle (facultatif, défaut anthropic/claude-haiku-5.5) : il doit lire les images et accepter un format JSON imposé.
OPENROUTER_MODEL=

# Relevés reçus par e-mail (Resend, réception) : SERVEUR UNIQUEMENT. Sans ces deux variables, la boîte n'est pas proposée.
# Secret de signature du webhook « email.received » (whsec_…), pointé sur /api/inbound/resend.
RESEND_WEBHOOK_SECRET=
# Clé Resend à accès complet : lecture des e-mails reçus et de leurs pièces jointes (la clé d'envoi ne suffit pas).
RESEND_INBOUND_KEY=
# Domaine de réception (enregistrement MX vers Resend), par défaut import.mesvaleurs.ma
INBOUND_EMAIL_DOMAIN=
