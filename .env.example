# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais commiter de fichier .env contenant des secrets.

# Nom affiché de l'application
NEXT_PUBLIC_APP_NAME=MesValeurs

# URL publique de l'application (liens dans les e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase : en local, valeurs affichées par `pnpm db:start` (API URL, clé anon / publishable).
# Sur Vercel : Project Settings > API du projet Supabase correspondant.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role / secret : SERVEUR UNIQUEMENT (invitations, tâches planifiées, webhooks).
# Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails transactionnels (Resend) — utilisé à partir de la Phase 2
RESEND_API_KEY=

# Secret protégeant les routes des tâches planifiées Vercel Cron — Phase 2
CRON_SECRET=
